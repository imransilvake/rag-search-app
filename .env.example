# Copy to .env.local and fill in real values before running `yarn dev`.
# Never commit .env.local.

# Supabase → Connect dialog or Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public key (Connect may label this PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Secret / server key (Connect labels this SECRET_KEY; legacy name: service_role)
SUPABASE_SECRET_KEY=sb_secret_your_key
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_jwt

# OpenAI → https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key
